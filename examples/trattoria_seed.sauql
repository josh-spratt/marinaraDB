-- Trattoria da Marinara — sample seed data
--
-- A small, realistic-feeling dataset for a fictional Italian restaurant:
-- 18 customers, 18 menu items, and 40 orders tying the two together.
--
-- Run it through the REPL to build a demo .pot file:
--   cargo run -- trattoria.pot < examples/trattoria_seed.sauql
--
-- Then explore it interactively:
--   cargo run -- trattoria.pot
--   marinara> SERVE * FROM customers STRAINED BY loyalty_points > 100
--   marinara> SERVE name, price FROM dishes STRAINED BY vegetarian = 1 ARRANGED BY price
--
-- Note: orders.customer_id and orders.dish_id are plain INTEGER columns,
-- not enforced Marinara Bonds (foreign keys aren't in v1) - they line up
-- with the Al Dente Keys assigned below because customers and dishes are
-- inserted first, in id order, into a fresh pot.
--
-- Also note: the REPL splits statements on the first semicolon it sees,
-- even inside a comment, so keep semicolons out of comment lines here.

PLATE noodle customers (
  name           TEXT NOT VUOTO,
  phone          TEXT NOT VUOTO,
  email          TEXT NOT VUOTO,
  loyalty_points INT NOT VUOTO
);

PLATE noodle dishes (
  name        TEXT NOT VUOTO,
  category    TEXT NOT VUOTO,
  price       REAL NOT VUOTO,
  vegetarian  INT NOT VUOTO
);

PLATE noodle orders (
  customer_id   INT NOT VUOTO,
  dish_id       INT NOT VUOTO,
  quantity      INT NOT VUOTO,
  total         REAL NOT VUOTO,
  table_number  INT NOT VUOTO
);

-- Customers (ids 1-18, assigned in insertion order)
LADLE INTO customers (name, phone, email, loyalty_points) PORTIONS
  ('Maria Rossi', '555-0101', 'maria.rossi@example.com', 120),
  ('Luca Bianchi', '555-0102', 'luca.bianchi@example.com', 45),
